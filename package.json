{
  "name": "zaia",
  "type": "module",
  "version": "1.0.0",
  "description": "ZAIA erweitert Zotero um einen KI-gestützten Assistenten für Fragen, Zusammenfassungen und die kontextbezogene Arbeit mit wissenschaftlichen Publikationen.",
  "config": {
    "addonName": "ZAIA - Zotero AI Assistent",
    "addonID": "zaia@zaia-plugin.vercel.app",
    "addonRef": "zaia",
    "addonInstance": "ZAIA",
    "prefsPrefix": "extensions.zotero.zaia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rausch6/wi-projekt-gruppe-2-sose-2026.git"
  },
  "author": "Gruppe 2 - WI-Projekt - SoSe 2026",
  "bugs": {
    "url": "https://github.com/Rausch6/wi-projekt-gruppe-2-sose-2026/issues"
  },
  "homepage": "https://zaia-plugin.vercel.app",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "vitest run",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "natural": "^8.1.1",
    "stopwords-iso": "^1.1.0",
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.13",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9",
    "typescript-eslint": "^8.28.0",
    "zotero-plugin-scaffold": "^0.4.1",
    "zotero-types": "^4.0.0-beta.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
